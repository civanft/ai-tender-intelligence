map $http_upgrade $ati_connection_upgrade {
    default upgrade;
    ''      close;
}

# A first Streamlit load fetches many hashed assets at once. Keep the request
# limit for dynamic endpoints, but do not charge immutable static files to it.
map $uri $ati_request_key {
    ~^/static/ "";
    default $binary_remote_addr;
}

limit_req_zone $ati_request_key zone=ati_requests_v2:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=ati_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name __SITE_DOMAIN__ www.__SITE_DOMAIN__;

    if ($host = www.__SITE_DOMAIN__) {
        return 301 https://__SITE_DOMAIN__$request_uri;
    }

    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # Deny private paths explicitly; retain ACME's public certificate challenge.
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location = /_stcore/health {
        access_log off;
        proxy_pass http://127.0.0.1:8501;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        alias /var/www/tender-meridian/robots.txt;
    }

    location = /sitemap.xml {
        alias /var/www/tender-meridian/sitemap.xml;
    }

    location = /about {
        return 308 /about/;
    }

    location ^~ /about/ {
        alias /var/www/tender-meridian/about/;
        index index.html;
    }

    location / {
        limit_req zone=ati_requests_v2 burst=40 nodelay;
        limit_conn ati_connections 20;

        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ati_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
